            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "streetaddressparser",
        "address parsing api",
        "street address parser api",
        "address parser",
        "address normalization api",
        "parse street address"
    ],
    "homepage": "https://apiverve.com/marketplace/streetaddressparser?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/streetaddressparser",
        "source": "https://github.com/apiverve/streetaddressparser-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Streetaddressparser\\": "php/src/"
        }
    },
